{
  "name": "ai-found-score",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "dev": { "port": 8787 },
  // Background scans (src/scan-workflow.js). One instance per scan; POST /api/admin/scan creates it.
  // Needs Workers Paid in production: a scan makes ~60-110 subrequests and needs more than the
  // Free plan's 10 ms CPU per step.
  "workflows": [
    { "name": "scan-workflow", "binding": "SCAN_WORKFLOW", "class_name": "ScanWorkflow" }
  ],
  // Daily at 14:00 UTC (10am New York): start the free 30-day re-check for every paid report that's due
  // (src/worker.js scheduled → src/lib/auto-scan.js startDueRechecks). Needs SUPABASE_SERVICE_KEY.
  "triggers": { "crons": ["0 14 * * *"] },
  // Per-IP brake on the public form endpoints (POST /api/request, GET /api/questions), src/lib/rate-limit.js.
  // 20 calls per minute per IP per endpoint: a real owner makes 1-3. Per Cloudflare location and
  // eventually consistent, so it stops floods, not the odd extra request.
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Live preview (POST /api/live-preview, src/lib/live-preview.js): 3 per minute per IP. The binding
    // only has 10 s / 60 s periods; the per-IP daily cap (3) and the global daily spend cap
    // (LIVE_PREVIEW_DAILY_USD, default 1.00) are counted from scan_usage instead.
    { "name": "PREVIEW_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  // Plain vars live here: `wrangler deploy` replaces dashboard Text vars with
  // this block. Secrets (SUPABASE_ANON_KEY, STRIPE_WEBHOOK_SECRET) stay in the
  // dashboard and survive deploys.
  // TURNSTILE_SITE_KEY is public (it goes into the page): the owner's widget in Cloudflare
  // dashboard -> Turnstile (Managed; aifoundscore.com, www.aifoundscore.com). Its secret is the Worker
  // secret TURNSTILE_SECRET_KEY (`npx wrangler secret put TURNSTILE_SECRET_KEY`), never in this file.
  // Until both are set the form is not bot-checked (README "Bot protection").
  "vars": {
    "SUPABASE_URL": "https://bahmemiydzpotfrxmlzw.supabase.co",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFCuveyMfQ21Ntcr",
    // Free-report requests (src/lib/auto-scan.js): "on" scans each verified request at once (Workers
    // Paid + supabase/v4_ladder.sql first); anything else queues it for Run now in /admin. Optional caps:
    // AUTO_SCAN_DAILY_MAX (default 25), AUTO_SCAN_DAILY_USD (default 20). Set here, not in the dashboard.
    "AUTO_SCAN": "off"
  },
  // PR preview builds (Workers Builds on non-production branches). Wrangler requires this block and
  // never copies production vars or ratelimits into it. Preview-safe values: Cloudflare's always-pass
  // Turnstile test site key (the real widget only allows aifoundscore.com), AUTO_SCAN off so a
  // preview never starts a paid scan, and rate-limit namespaces of their own. SUPABASE_URL is the
  // public project URL: give previews Supabase secrets only if a preview should reach the database.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://bahmemiydzpotfrxmlzw.supabase.co",
      "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      "AUTO_SCAN": "off",
      "RECHECK_SCAN": "off"
    },
    "ratelimits": [
      { "name": "REQUEST_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
      { "name": "PREVIEW_LIMITER", "namespace_id": "2002", "simple": { "limit": 3, "period": 60 } }
    ]
  }
}
